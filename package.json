{
  "name": "portfolio2026",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts tests --max-warnings 0",
    "content:check": "node scripts/check-content.mjs",
    "content:ready": "node scripts/check-content.mjs --strict",
    "verify:html": "node scripts/check-html.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "verify:http": "node scripts/check-http.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run verify:html && npm run verify:http"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.536.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.5.28",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
